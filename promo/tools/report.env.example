# 🔴 값을 꺾쇠(<>)로 감싸지 마세요. 예시의 <발급값> 은 자리표시일 뿐입니다 —
#    KEY=<abc> 가 아니라 KEY=abc 로 적습니다.
# 리포트(유료 옵션) 로컬 뷰어 설정 — 홍보영상 실화면 E 촬영용
#
# 🔴 값은 사람이 직접 채웁니다. 이 파일에는 이름만 있습니다.
# 🔴 채운 파일은 `.local/report.env` 로 두세요. `.local/` 은 gitignore 되어 커밋되지 않습니다.
#
#   cp tools/report.env.example .local/report.env      # 그리고 값을 채운다
#   node tools/report-local.mjs                        # http://127.0.0.1:5178

# ── 필수 ──────────────────────────────────────────────────────────────
# 이 줄이 true 여야 리포트가 돕니다. 아니면 상품이 404(report_disabled)로 답합니다.
KIOSK_REPORT_ENABLED=true

# 이폼사인 API 키 — 발급: 이폼사인 로그인 > 우측 상단 계정 메뉴 > 회사 관리 > API 관리 > API 키 발급
EFORMSIGN_API_KEY=

# 같은 화면(회사 관리 > API 관리)에서 API 키와 함께 받는 개인키(hex 문자열).
# 🔴 발급 시 한 번만 보여 줍니다. 잃어버리면 재발급해야 합니다.
EFORMSIGN_PRIVATE_KEY=

# 브라우저에서 /api/report 를 열 때 쓰는 열쇠. 아무 문자열이나 직접 정하면 됩니다(예: 32자 무작위).
REPORT_SECRET=

# ── 선택 ──────────────────────────────────────────────────────────────
# 특정 서식의 문서만 집계할 때. 값은 .local/template.json 의 templateId 와 같습니다.
KIOSK_FORM_ID=

# 조회 기간(일). 기본 30. 촬영용 데모 문서가 며칠 안에 몰려 있으면 7 정도로 줄여도 됩니다.
KIOSK_REPORT_DAYS=30

# on 이면 서식 항목 **값**(이름·소속 등)까지 표에 실립니다. 기본은 끔.
# 🔴 촬영용 데모 계정의 가짜 데이터(홍길동/한빛디자인 등)일 때만 켜세요.
KIOSK_REPORT_FIELD_VALUES=on

# 🔴 **반드시 채우세요**(이폼사인 로그인 이메일 = 멤버 계정 아이디).
# 비워 두면 회사 토큰으로 발급돼 문서 목록 조회가 401 로 막힙니다
# (2026-09-18 실측: {"code":"4010001","ErrorMessage":"The access_token claim is invalid."}).
EFORMSIGN_MEMBER_ID=

# ── 로컬 뷰어에서는 쓰지 않습니다(참고) ────────────────────────────────
# 실제 배포에서 결과를 밖으로 보낼 때 쓰는 값들입니다. 촬영에는 필요 없습니다.
# REPORT_WEBHOOK_URL=
# RESEND_API_KEY=
# REPORT_TO_EMAIL=
# REPORT_FROM_EMAIL=
